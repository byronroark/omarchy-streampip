#!/usr/bin/env bash
# Backend for the native Stream PiP Omarchy popup.
set -euo pipefail

state_dir="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/live-stream-pip"
streams_file="$state_dir/streams.tsv"
legacy_url_file="$state_dir/stream-url"
mkdir -p "$state_dir"
chmod 700 "$state_dir"

if [[ ! -e "$streams_file" && -r "$legacy_url_file" ]]; then
  legacy_url=$(<"$legacy_url_file")
  [[ -n "$legacy_url" ]] && { umask 077; printf 'Last stream\t%s\taudible\n' "$legacy_url" > "$streams_file"; }
fi

valid_row() { [[ ${1:-} =~ ^[0-9]+$ ]] && [[ -s "$streams_file" ]] && sed -n "${1}p" "$streams_file" | grep -q $'\t'; }

list_streams() {
  [[ -s "$streams_file" ]] || return 0
  local row=0 name url audio
  while IFS=$'\t' read -r name url audio; do
    row=$((row + 1))
    [[ -n "$name" && -n "$url" ]] && printf '%s\t%s\t%s\n' "$row" "$name" "${audio:-audible}"
  done < "$streams_file"
}

add_stream() {
  local name=${1:-} url=${2:-} audio=${3:-audible}
  [[ -n "$name" && "$name" != *$'\t'* && "$name" != *$'\n'* ]] || { echo 'Stream name is required.' >&2; return 2; }
  [[ "$url" =~ ^rtsps?:// && "$url" != *$'\t'* && "$url" != *$'\n'* ]] || { echo 'Use an rtsp:// or rtsps:// URL.' >&2; return 2; }
  [[ "$audio" == muted ]] || audio=audible
  umask 077
  printf '%s\t%s\t%s\n' "$name" "$url" "$audio" >> "$streams_file"
  chmod 600 "$streams_file"
}

rewrite_streams() {
  local row=$1 mode=$2 temp line current=0 name url audio
  umask 077; temp=$(mktemp "$state_dir/streams.tsv.XXXXXX"); chmod 600 "$temp"
  while IFS= read -r line || [[ -n "$line" ]]; do
    current=$((current + 1))
    if [[ "$current" != "$row" ]]; then
      printf '%s\n' "$line" >> "$temp"; continue
    fi
    IFS=$'\t' read -r name url audio <<< "$line"
    if [[ "$mode" == toggle ]]; then
      [[ "$audio" == muted ]] && audio=audible || audio=muted
      printf '%s\t%s\t%s\n' "$name" "$url" "$audio" >> "$temp"
    fi
  done < "$streams_file"
  mv "$temp" "$streams_file"
}

launch_stream() {
  local row=$1 line name url audio playlist_file
  valid_row "$row" || return 2
  line=$(sed -n "${row}p" "$streams_file")
  IFS=$'\t' read -r name url audio <<< "$line"
  [[ -n "$url" ]] || return 2
  local mpv_audio_args=()
  [[ "$audio" == muted ]] && mpv_audio_args+=(--mute=yes)
  umask 077
  playlist_file=$(mktemp "$state_dir/session.XXXXXX")
  chmod 600 "$playlist_file"
  printf '%s\n' "$url" > "$playlist_file"
  trap 'rm -f "$playlist_file"' EXIT
  mpv --force-window=immediate --title="Stream PiP" --wayland-app-id="omarchy-stream-pip" \
    --profile=low-latency --cache=yes --demuxer-max-bytes=8MiB --demuxer-max-back-bytes=2MiB \
    "${mpv_audio_args[@]}" --playlist="$playlist_file"
}

case ${1:-list} in
  --list|list) list_streams ;;
  --add) add_stream "${2:-}" "${3:-}" "${4:-audible}" ;;
  --toggle) valid_row "${2:-}" && rewrite_streams "$2" toggle ;;
  --delete) valid_row "${2:-}" && rewrite_streams "$2" delete ;;
  --launch) launch_stream "${2:-}" ;;
  *) echo "Usage: stream-pip [--list|--add NAME URL [muted]|--toggle ROW|--delete ROW|--launch ROW]" >&2; exit 2 ;;
esac
